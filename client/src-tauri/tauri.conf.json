{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tianshu Provider",
  "version": "0.1.0",
  "identifier": "cloud.tianshu-gateway.provider-client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "天枢 Provider",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://tianshu-gateway.cloud; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://tianshu-gateway.cloud wss://tianshu-gateway.cloud"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "tooltip": "天枢 Provider"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "lkang",
    "shortDescription": "Tianshu LLM Gateway provider client",
    "longDescription": "Provider desktop client for the Tianshu LLM Gateway. Manages local inference engines, reverse-tunnel uplink, and backend registration."
  },
  "plugins": {
    "autostart": {
      "enabled": false
    }
  }
}
